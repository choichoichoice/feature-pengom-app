<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 13+ 테마 아이콘용 단색 레이어. 시스템이 그림 모양만 따서 한 가지 색으로 칠한다.
  그림(ic_launcher_art, 투명 배경 정사각형 PNG)을 사방 28dp 안쪽(가로세로 52dp)에 놓는다.
  52dp 정사각형 안의 그림이 중심에서 33dp 이내, 즉 66dp 안전 원 안에 모두 들어가게 맞춘 값이다
  (현재 그림 기준으로 계산함. 그림을 바꾸면 docs: pengom-android/ICON.md 참고).
-->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/ic_launcher_art"
    android:inset="28dp" />
